# FloatChat Environment Variables
# For hackathon local demo, DEMO_MODE=true runs 100% offline without external keys
DEMO_MODE=true

# Optional LLM Key for live natural language intent parsing & explanations
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Optional Copernicus Marine / Argovis Credentials
ARGO_API_URL=https://api.argovis.colorado.edu/v2
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
